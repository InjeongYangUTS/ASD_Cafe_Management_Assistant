# =====================================================================
# Student 1 (Hangyeol Yi) - Customer Feedback & Reviews
# Local configuration. Copy to .env and adjust:  cp .env.example .env
#
# .env is git-ignored. This example file is committed so a teammate or
# marker can reproduce the setup without guessing variable names.
# =====================================================================

# ---- AI-Mode (Ollama, OpenAI-compatible endpoint) -------------------
# Host machine:              http://localhost:11434/v1
# Docker Compose (ollama container): http://ollama:11434/v1
# Container -> Ollama on the host:   http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# Approved open-source LLM from the Project Group Registration Form.
OLLAMA_MODEL=llama3.2

# Second model, used only by the agentic loop's review agent so that the
# work is not reviewed by the same model that produced it.
OLLAMA_REVIEW_MODEL=qwen2.5:0.5b

# Seconds to wait for a generation. A cold model load is slow.
AI_TIMEOUT=180

# ---- Service URLs ---------------------------------------------------
# 127.0.0.1 rather than "localhost": on Windows, resolving "localhost"
# tries IPv6 first and costs about two seconds per call.
DB_SERVICE_URL=http://127.0.0.1:7100
ORDER_SERVICE_URL=http://127.0.0.1:8400
BACKEND_URL=http://127.0.0.1:8100

# ---- Local ports ----------------------------------------------------
FEEDBACK_FRONTEND_PORT=5110
FEEDBACK_DATABASE_PORT=7100
FEEDBACK_BACKEND_PORT=8100
