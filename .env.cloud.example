# Copy this file to .env.cloud on the EC2 instance.
# Never commit .env.cloud because it contains the real session secret.
SHARED_SECRET_KEY=replace-with-output-from-openssl-rand-hex-32

# Public address used by the Student 3 return link.
# Use the EC2 public IPv4 address or DNS name, without http:// or a port.
PUBLIC_HOST=ec2-public-ip-or-dns
PUBLIC_SCHEME=http
